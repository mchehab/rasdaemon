"""
Rasdaemon meson configuration.

This file is generated by meson with compile-time variables
"""

import os


class RasMesonConfig:
    version = "@PACKAGE_VERSION@"
    env_file = "@RASDAEMON_ENV@"
    install_prefix = "@prefix@"
    sysconf_dir = "@sysconfdir@"
    sbin_dir = "@sbindir@"


class Sqlite3ConnParms:
    def __init__(self):
        self.database = os.environ.get(
            "RAS_SQLITE3_DATABASE", "@SQLITE3_DATABASE@"
        )
