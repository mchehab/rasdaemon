# Test configuration for the PostgreSQL backend.
# The rasdaemon_test database and rasdaemon schema must exist.
RASDAEMON_DB_BACKEND="postgresql"
RASDAEMON_HOSTNAME="local-host"
RAS_PG_HOST="127.0.0.1"
RAS_PG_PORT="5432"
RAS_PG_USER="rasdaemon"
RAS_PG_PASSWORD="mypass"
RAS_PG_DATABASE="rasdaemon_test"
RAS_PG_SCHEMA="rasdaemon"
RAS_PG_SSL_MODE="false"
RAS_PG_CONNECT_TIMEOUT="10"
