# Test configuration for the MySQL/MariaDB backend.
# The rasdaemon_test database and rasdaemon user must already exist.
RASDAEMON_DB_BACKEND="mysql"
RASDAEMON_HOSTNAME="local-host"
RAS_MYSQL_HOST="127.0.0.1"
RAS_MYSQL_PORT="3306"
RAS_MYSQL_USER="rasdaemon"
RAS_MYSQL_PASSWORD="mypass"
RAS_MYSQL_DATABASE="rasdaemon_test"
RAS_MYSQL_SOCKET=""
RAS_MYSQL_USE_SSL="false"
RAS_MYSQL_CONNECT_TIMEOUT="10"
