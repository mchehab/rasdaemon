#!/bin/bash

script_dir=$(cd -- "$(dirname -- "$0")" && pwd)
ras_mc_ctl="$script_dir/build/ras-mc-ctl"

if [[ ! -x "$ras_mc_ctl" ]]; then
	echo "warning: $ras_mc_ctl is not available; build rasdaemon first" >&2
	exit 1
fi

python_dir=$(find "$script_dir/install" -type d -name '*-packages' -print \
	2>/dev/null | head -n 1)
if [[ -z "$python_dir" ]]; then
	echo "warning: no staged Python package directory found under $script_dir/install" >&2
	exit 1
fi

RAS_PYTHON_DIR="$python_dir" \
	PYTHONPATH="$python_dir:$script_dir/util${PYTHONPATH:+:$PYTHONPATH}" \
	exec "$ras_mc_ctl" $@
